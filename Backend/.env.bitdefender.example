# Bitdefender GravityZone live account settings
# Copy only these variables into your active environment or .env.local.
# Do not overwrite the current project .env values.

# IMPORTANT: use the exact Access URL region for your account.
# Common values: cloud.gravityzone.bitdefender.com / cloudap.gravityzone.bitdefender.com
BITDEFENDER_API_URL=https://cloudap.gravityzone.bitdefender.com/api/v1.0/jsonrpc
BITDEFENDER_API_KEY=PASTE_YOUR_GRAVITYZONE_API_KEY_HERE

# Package created in GravityZone Control Center > Network > Packages
BITDEFENDER_PACKAGE_ID=PASTE_YOUR_PACKAGE_ID_HERE
BITDEFENDER_PACKAGE_NAME=PASTE_YOUR_PACKAGE_NAME_HERE

# App-level safe quota for self-help scans
BITDEFENDER_SCAN_RUN_LIMIT=3

# Optional metadata for troubleshooting
BITDEFENDER_ACCOUNT_REGION=cloudap
BITDEFENDER_INSTALL_MODE=manual
BITDEFENDER_INSTALL_TYPE=full-kit
