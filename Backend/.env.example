# Copy to .env and fill in. Never commit the real .env.

# ── Core ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/visiontech
# Long random string; changing it logs everyone out.
JWT_SECRET=
# Frontend origin allowed by CORS and used in password-reset links.
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins, comma separated.
CORS_ALLOWED_ORIGINS=

# Encrypts secrets stored in the database (SMTP password). Set it before saving
# SMTP settings and keep it stable: values encrypted with it can't be read without it.
CONFIG_ENCRYPTION_KEY=
# Only for a dev SMTP server with a self-signed certificate.
SMTP_ALLOW_SELF_SIGNED=false

# Development only — never set these in production.
# RATE_LIMIT_DISABLED=true   turns off login/code/installer rate limits
# DISABLE_CRON=true          starts the API without scheduled jobs
# DEBUG_GRAVITYZONE=true     logs full Bitdefender API payloads (contain customer data)

# ── PayPal ────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" for real payments; anything else uses Sandbox.
PAYPAL_MODE=sandbox
# Id of the webhook created in the PayPal developer dashboard (events are verified with PayPal).
PAYPAL_WEBHOOK_ID=

# ── Stripe (card payments) ────────────────────────────
# Secret key: sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…): from `stripe listen` locally, or from the
# endpoint created in Dashboard → Developers → Webhooks in production.
STRIPE_WEBHOOK_SECRET=

# ── Tactical RMM ──────────────────────────────────────
TACTICALRMM_BASE_URL=
TACTICALRMM_API_KEY=
# Client that holds one Site per customer (CyberShield Solo = 12).
RMM_CLIENT_ID=
# Sites the app may change (installer links, uninstall, scripts). "*" = all
# (production); a test Site id while developing; empty = no changes at all.
RMM_WRITE_ALLOWED_SITE_IDS=
# true = create and link a Site automatically for a customer without one.
RMM_AUTO_CREATE_SITES=false
# Tactical library scripts used for customer actions (built-ins:
# "Reboot/Restart Computer" and "Disk - Cleanup C: drive"). Unset = action hidden.
RMM_SCRIPT_RESTART_ID=
RMM_SCRIPT_CLEANUP_ID=
# Tactical RMM website; staff "Remote desktop" opens <url>/takecontrol/<agent>.
RMM_WEB_URL=

# ── Bitdefender GravityZone ───────────────────────────
BITDEFENDER_API_URL=
BITDEFENDER_API_KEY=
BITDEFENDER_PACKAGE_ID=
CYBERSHIELD_SOLO_ID=

# ── Cloudinary (admin data management uploads) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Seed script only (npm run seed:dev / seed:prod) ───
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ALLOWED_IPS=*
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
